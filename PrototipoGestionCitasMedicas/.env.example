# Plataforma de Gestion de Citas Medicas - Variables de entorno
# Copia este archivo como .env y ajusta los valores segun el ambiente.

# Base de datos MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=19031203
DB_NAME=gestioncitas
MYSQL_ROOT_PASSWORD=19031203

# Puertos publicados al host
PORT_FRONTEND=80
PORT_GATEWAY=8080
PORT_MYSQL=3306

# Puertos internos de microservicios
PORT_MS_USUARIOS=3001
PORT_MS_DISPONIBILIDAD=3003
PORT_MS_CITAS=3004
PORT_MS_ESPECIALIDADES=3007

# URLs internas para comunicacion entre servicios en Docker
MS_USUARIOS_URL=http://ms-usuarios:3001
MS_DISPONIBILIDAD_URL=http://ms-disponibilidad:3003
MS_CITAS_URL=http://ms-citas:3004
MS_ESPECIALIDADES_URL=http://ms-especialidades:3007
