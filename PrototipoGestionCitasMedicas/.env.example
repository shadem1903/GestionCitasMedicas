# ═══════════════════════════════════════════════════════════
#  Plataforma de Gestión de Citas Médicas — Variables de entorno
#  Copia este archivo como .env y ajusta los valores si es necesario.
#  NUNCA subas el .env real al repositorio.
# ═══════════════════════════════════════════════════════════

# ── Base de datos MySQL ──────────────────────────────────
DB_HOST=mysql          # Nombre del servicio en Docker (no usar localhost)
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=changeme   # Cambia esto en producción
DB_NAME=citas_db

MYSQL_ROOT_PASSWORD=changeme_root   # Contraseña del root de MySQL

# ── Puertos de cada microservicio ───────────────────────
PORT_MS_USUARIOS=3001
PORT_MS_DISPONIBILIDAD=3003
PORT_MS_CITAS=3004
PORT_MS_ESPECIALIDADES=3007
PORT_FRONTEND=80

# ── URLs inter-servicio (dentro de Docker usar nombre de servicio) ──
MS_USUARIOS_URL=http://ms-usuarios:3001
MS_ESPECIALIDADES_URL=http://ms-especialidades:3007
MS_DISPONIBILIDAD_URL=http://ms-disponibilidad:3003
